# Supabase (schema sijagaair diposting di dashboard → API → Extra schemas)
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_public_key>

VITE_DEFAULT_DEPLOYMENT_SLUG=sijagaair-bojong-kulur

# Fastify API (signed URL CCTV, admin CRUD, dll.)
VITE_SIJAGAAIRAPI_URL=http://localhost:3100

# Cloudflare Turnstile — SITE KEY saja (bukan secret).
# Secret Turnstile hanya di Supabase Dashboard → Authentication → Attack Protection.
# Tanpa ini, login gagal jika CAPTCHA protection aktif.
VITE_TURNSTILE_SITE_KEY=
